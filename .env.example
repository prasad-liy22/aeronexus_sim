# Copy to .env.local, which git ignores, and restart Vite after changing it.

# Where the web app finds the Signal Receiver. This is the default. An address saved
# in the app's transmitter panel overrides it in that browser, until "Use default".
# VITE_SIGNAL_RECEIVER_URL=http://localhost:3000

# The transmitter's calibration is built in. See src/config/transmitter.ts.
